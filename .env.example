# Copy to `.env` and fill in. Every key is optional: when a provider key is empty,
# that provider switches to FAKE mode automatically (see README).

# --- External providers -------------------------------------------------------
# OpenAI API key (https://platform.openai.com/api-keys). Empty => FAKE_LLM.
OPENAI_API_KEY=
# Tavily search API key (https://app.tavily.com). Empty => FAKE_TAVILY.
TAVILY_API_KEY=
# Telegram bot token from @BotFather. Empty => FAKE_TELEGRAM (digests only stored in the DB).
TELEGRAM_BOT_TOKEN=
# Bot username without "@", used for the deep link https://t.me/<username>?start=<token>.
TELEGRAM_BOT_USERNAME=NewsDigestBot

# Force a fake provider even when a key is present (1/0).
# FAKE_LLM=0
# FAKE_TAVILY=0
# FAKE_TELEGRAM=0

# --- App -------------------------------------------------------------------------
# Long random string used to sign session JWTs. Generate: openssl rand -hex 32
JWT_SECRET=change-me
# Public URL of the site (used in bot messages).
PUBLIC_BASE_URL=http://localhost:8080
# Host port for the web UI.
WEB_PORT=8080
# development | production (production => Secure cookies, requires HTTPS)
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Storage ---------------------------------------------------------------------
MYSQL_DATABASE=newsdigest
MYSQL_USER=newsdigest
MYSQL_PASSWORD=newsdigest
MYSQL_ROOT_PASSWORD=rootpassword
REDIS_URL=redis://redis:6379/0

# --- LLM -------------------------------------------------------------------------
# Cheap model for topic expansion; stronger model for the final digest.
LLM_MODEL_FAST=gpt-6-luna
LLM_MODEL_DIGEST=gpt-6.1-sol

# --- Pipeline --------------------------------------------------------------------
# Local multilingual embedding model (fastembed, no API key, cached in a volume).
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Minimum cosine similarity between an article and the topic profile (description + queries).
RELEVANCE_THRESHOLD=0.30
# Articles more similar than this to each other are treated as one event.
CLUSTER_THRESHOLD=0.80
MAX_TOPICS_PER_USER=10
MAX_EVENTS_PER_DIGEST=10
TAVILY_MAX_RESULTS=10
